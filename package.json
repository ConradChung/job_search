    "drafts": "tsx --env-file=.env.local scripts/drafts.ts",
    "enrich": "tsx --env-file=.env.local scripts/enrich-jobs.ts",
    "classify": "tsx --env-file=.env.local scripts/classify-jobs.ts",
    "reselect": "tsx --env-file=.env.local scripts/apply-selection.ts",
    "split-sales": "tsx --env-file=.env.local scripts/split-sales.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "geist": "^1.8.2",
    "lucide-react": "^1.57.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
